#===========================================
# ====== Cerve Service
# ==========================================
SERVICE_PORT=3000
SERVICE_VERSION="1.0.0"
SERVICE_DOMAIN="localhost"
SERVICE_NAME="cerve-engine"
SERVICE_CLIENT="http://localhost:5768"

# ==========================================
# ====== PostgreSQL Datastore
# ==========================================
POSTGRES_SAMPLER_URL="postgresql://sampler:<sampler_password>@localhost:5432/cerve"
POSTGRES_RUNNER_URL="postgresql://runner:<runnner_password>@localhost:5432/cerve"

# ==========================================
# ====== Redis Cache Memory
# ==========================================
REDIS_CACHE_URL="redis://:<redis_password>@localhost:6380"

# ==========================================
# ====== Redis Queues & Locking
# ==========================================
REDIS_QUEUES_URL="redis://:<redis_password>@localhost:6379"

# ==========================================
# ======= CORS Policies
# ==========================================
CORS_METHODS="GET,POST,PUT,DELETE,OPTIONS"
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"