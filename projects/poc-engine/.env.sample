# ==========================================
# Service
# ==========================================
APP_PORT=3000
APP_VERSION="1.0.0"
APP_NAME="POC Engine"
BUN_ENV="development"

# ==========================================
# PostgreSQL
# ==========================================
POSTGRES_USERNAME="bullky"
POSTGRES_PASSWORD="<postgrsql_password>"
POSTGRES_CONNECTION="postgresql://bullky:<postgrsql_password>@localhost:5432/kelsen"

# ==========================================
# Redis
# ==========================================
REDIS_QUEUE_URL="redis://:<redis_password>@localhost:6379"
REDIS_CACHE_URL="redis://:<redis_password>@localhost:6379"

# ==========================================
# Security
# ==========================================
CORS_METHODS="GET,POST,PUT,DELETE,OPTIONS"
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"
